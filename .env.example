# External URL users open (e.g. https://relayproof.example.com or http://localhost:3000).
APP_URL=
COOKIE_SECURE=
LOCAL_PORT=
# Keep local self-registration closed for private installations.
ALLOW_SIGNUP=

# Database credentials (used by Docker Compose and local scripts).
DB_ADMIN_PASSWORD=
DB_APP_PASSWORD=
DATABASE_ADMIN_URL=
DATABASE_URL=
DB_POOL_MAX=

# Encryption key for provider credentials (openssl rand -base64 32).
RELAY_ENCRYPTION_KEY=

# Optional demo seeding (npm run db:demo) for isolated test environments.
DEMO_MODE=
DEMO_EMAIL=
DEMO_PASSWORD=

# Optional E-mail. Use an authenticated TLS-capable SMTP URL.
SMTP_URL=
MAIL_FROM=
# Optional WorkOS AuthKit federated identity.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Optional Jira 3LO. API token mode is also available.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Optional comma-separated exact ServiceNow vanity hostnames.
SERVICENOW_CUSTOM_HOSTS=
